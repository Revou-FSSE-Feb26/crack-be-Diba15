		{
			"name": "03. Artworks & Anti-AI Curation",
			"description": "Endpoint unggah karya, feed publik, antrean kurasi anti-AI, dan master tag.",
			"item": [
				{
					"name": "3.1 Post Artwork with WIP Proof (Artist)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"var data = pm.response.json();",
									"if (data && data.id) {",
									"    pm.environment.set('artwork_id', data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{artist_token}}", "type": "string" }]
						},
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Lukisan Digital Nusantara #{{$timestamp}}\",\n  \"description\": \"Karya seni digital manual bertema kebudayaan Indonesia dengan bukti layer WIP.\",\n  \"imagesUrl\": [\n    \"https://picsum.photos/seed/artwork-postman/800/600\"\n  ],\n  \"wipProofUrl\": \"https://picsum.photos/seed/artwork-wip-postman/800/600\",\n  \"uploadType\": \"original\",\n  \"tagNames\": [\"digital_art\", \"nusantara\"]\n}"
						},
						"url": {
							"raw": "{{base_url}}/artworks",
							"host": ["{{base_url}}"],
							"path": ["artworks"]
						}
					}
				},
