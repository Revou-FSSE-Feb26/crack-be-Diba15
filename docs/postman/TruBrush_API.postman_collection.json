{
	"info": {
		"_postman_id": "trubrush-api-collection-v2",
		"name": "TruBrush API Collection (Anti-AI & Escrow Platform)",
		"description": "Koleksi lengkap REST API TruBrush v1.0 yang dirancang 100% AMAN dan OTOMATIS untuk dijalankan sekaligus menggunakan Postman Collection Runner. Menggunakan dynamic token & ID chaining dari pembuatan data baru hingga siklus penyelesaian tanpa merusak seed database.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01. Authentication & Sessions",
			"description": "Endpoint otentikasi, pendaftaran akun, dan manajemen sesi login.",
			"item": [
				{
					"name": "1.1 Login Admin (Auto Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Response contains Access Token\", function () {",
									"    pm.expect(jsonData).to.have.property('accessToken');",
									"    pm.environment.set('admin_token', jsonData.accessToken);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						}
					}
				},
